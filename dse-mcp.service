[Unit]
Description=DSE Analysis MCP Server — HTTP API for stock analysis
After=network.target

[Service]
Type=simple
User=dse
WorkingDirectory=/home/dse/dse-analyst-mcp
Environment="PATH=/home/dse/dse-analyst-mcp/.venv/bin"
ExecStart=/home/dse/dse-analyst-mcp/.venv/bin/python3 server.py --transport http --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryLimit=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
