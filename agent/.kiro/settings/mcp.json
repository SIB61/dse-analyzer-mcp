{
  "mcpServers": {
    "DSE-ANALYZER": {
      "command": "uv",
      "args": [
        "run",
        "dse-analyst-mcp",
        "--transport",
        "stdio"
      ],
      "autoApprove": true,
      "alwaysAllow": [
        "get_live_price",
        "get_historical_data",
        "get_market_summary",
        "get_top_gainers",
        "get_top_losers",
        "get_all_live_prices",
        "get_company_info",
        "analyze_trend",
        "analyze_momentum",
        "analyze_volatility",
        "analyze_volume",
        "get_fibonacci_levels",
        "get_ichimoku_cloud",
        "get_pivot_points",
        "full_analysis",
        "scan_top_stocks",
        "get_engulfing_pattern",
        "scan_engulfing_stocks"
      ]
    }
  },
  "agents": {
    "DSE-ANALYZER": {
      "agentConfig": "../agents/DSE-ANALYZER.json"
    }
  }
}
